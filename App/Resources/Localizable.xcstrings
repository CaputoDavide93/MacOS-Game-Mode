    "finding.wifi24GHz": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WLAN auf 2,4 GHz, das ist überfüllt und langsam. Wechsle ins 5- oder 6-GHz-Netz oder schließ ein Kabel an."
          }
        },
        "en": {
          "stringUnit": {
