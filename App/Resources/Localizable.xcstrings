    "ui.mode.help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Einfach behebt alles mit einer Taste. Experte zeigt jede Zahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Basic fixes everything with one button. Advanced shows every number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Básica lo arregla todo con un botón. Avanzada muestra todos los números."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simple corrige tout en un bouton. Avancée affiche tous les chiffres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बेसिक एक बटन से सब कुछ ठीक कर देता है। एडवांस्ड हर संख्या दिखाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Base sistema tutto con un pulsante. Avanzata mostra ogni numero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "基本はボタンひとつですべて修正します。詳細はすべての数値を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기본은 버튼 하나로 모든 문제를 해결합니다. 고급은 모든 수치를 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Básico corrige tudo com um botão. O Avançado mostra todos os números."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“基本”只需一个按钮即可修复所有问题。“高级”显示所有数值。"
          }
        }
      }
    },
