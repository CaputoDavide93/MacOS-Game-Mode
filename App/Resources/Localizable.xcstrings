    "ui.xcloud.tune.help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stellt die höchste Bitrate, das H.264-High-Profil und „IPv6 bevorzugen“ ein und stellt deine eigenen Einstellungen wieder her, wenn der Spielmodus ausgeht. Braucht einen offenen xbox.com-Tab und im Browser „JavaScript von Apple Events erlauben“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the highest bitrate, the high H.264 profile and Prefer IPv6, and puts your own settings back when Game Mode goes off. Needs an open xbox.com tab and, in the browser, Allow JavaScript from Apple Events."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fija la tasa de bits máxima, el perfil alto de H.264 y Preferir IPv6, y restaura tus ajustes cuando se desactiva el modo Juego. Necesita una pestaña de xbox.com abierta y, en el navegador, Permitir JavaScript desde Apple Events."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Règle le débit maximal, le profil H.264 élevé et Préférer IPv6, puis rétablit vos réglages quand le mode Jeu se désactive. Nécessite un onglet xbox.com ouvert et, dans le navigateur, Autoriser JavaScript à partir des Apple Events."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सबसे ऊँचा बिटरेट, हाई H.264 प्रोफ़ाइल और IPv6 को प्राथमिकता सेट करता है, और गेम मोड बंद होने पर आपकी अपनी सेटिंग्ज़ वापस लाता है। इसके लिए xbox.com का खुला टैब और ब्राउज़र में \"Apple Events से JavaScript को अनुमति दें\" ज़रूरी है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Imposta il bitrate massimo, il profilo H.264 alto e Preferisci IPv6, e ripristina le tue impostazioni quando la Modalità gioco si spegne. Serve una scheda xbox.com aperta e, nel browser, Consenti JavaScript dagli Apple Events."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "最高ビットレート、H.264のHighプロファイル、IPv6を優先に設定し、ゲームモードがオフになると元の設定に戻します。xbox.comのタブを開いておき、ブラウザで「Apple EventsからのJavaScriptを許可」をオンにする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "최고 비트레이트, H.264 높은 프로파일, IPv6 우선 사용을 설정하고, 게임 모드가 꺼지면 원래 설정으로 되돌립니다. 열려 있는 xbox.com 탭과 브라우저의 'Apple 이벤트의 JavaScript 허용' 설정이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Define a maior taxa de bits, o perfil H.264 alto e Preferir IPv6, e restaura seus ajustes quando o Modo Jogo for desativado. Requer uma aba de xbox.com aberta e, no navegador, Permitir JavaScript de Eventos Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
