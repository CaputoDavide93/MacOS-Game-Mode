            "state": "needs_review",
            "value": "无法更改 Better xCloud 的设置。没有留下只改了一半的设置。"
          }
        }
      }
    },
    "ui.xcloud.jsDisabled": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Browser blockiert das. In Chrome oder Edge: Darstellung → Entwickler → JavaScript von Apple Events zulassen. In Safari: Entwickler → JavaScript von Apple Events erlauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The browser blocks this. In Chrome or Edge: View → Developer → Allow JavaScript from Apple Events. In Safari: Develop → Allow JavaScript from Apple Events."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El navegador lo bloquea. En Chrome o Edge: Ver → Desarrollador → Permitir JavaScript desde Apple Events. En Safari: Desarrollo → Permitir JavaScript desde Apple Events."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le navigateur bloque cette action. Dans Chrome ou Edge : Présentation → Options pour les développeurs → Autoriser JavaScript à partir des Apple Events. Dans Safari : Développement → Autoriser JavaScript à partir des Apple Events."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ब्राउज़र इसे ब्लॉक कर रहा है। Chrome या Edge में: देखें → डेवलपर → Apple Events से JavaScript को अनुमति दें। Safari में: डेवलप → Apple Events से JavaScript को अनुमति दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il browser lo blocca. In Chrome o Edge: Visualizza → Sviluppatore → Consenti JavaScript dagli Apple Events. In Safari: Sviluppo → Consenti JavaScript dagli Apple Events."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ブラウザによってブロックされています。ChromeまたはEdgeの場合：表示 → 開発 / 管理 → Apple Events からの JavaScript を許可。Safariの場合：開発 → Apple EventsからのJavaScriptを許可。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "브라우저가 이 작업을 차단하고 있습니다. Chrome 또는 Edge: 보기 → 개발자 정보 → Apple 이벤트의 자바스크립트 허용. Safari: 개발자용 → Apple 이벤트의 JavaScript 허용."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O navegador bloqueia isso. No Chrome ou Edge: Visualizar → Desenvolvedor → Permitir JavaScript de Apple Events. No Safari: Desenvolvedor → Permitir JavaScript de Eventos Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "浏览器阻止了此操作。在 Chrome 或 Edge 中：显示 → 开发者 → 允许来自 Apple 事件的 JavaScript。在 Safari 中：开发 → 允许来自 Apple 事件的 JavaScript。"
          }
        }
      }
    },
