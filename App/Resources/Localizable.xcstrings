    "ui.settings.speed.help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er lastet deine Internetleitung etwa 20 Sekunden lang voll aus."
          }
        },
        "en": {
          "stringUnit": {
