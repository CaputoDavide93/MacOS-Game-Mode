    "fix.quitApps.detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Im Hintergrund geöffnete Apps nutzen das WLAN oder die Leitung. Du wirst gebeten, alles Offene zu sichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps left open in the background use the Wi-Fi or the line. You'll be asked to save anything open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las apps abiertas en segundo plano usan el Wi-Fi o la línea. Se te pedirá que guardes lo que tengas abierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les apps restées ouvertes en arrière-plan utilisent le Wi-Fi ou la ligne. Vous serez invité à enregistrer ce qui est ouvert."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बैकग्राउंड में खुली ऐप्स Wi-Fi या लाइन का उपयोग करती हैं। खुली हुई चीज़ें सहेजने के लिए आपसे पूछा जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le app rimaste aperte in background usano il Wi-Fi o la linea. Ti verrà chiesto di salvare ciò che è aperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "バックグラウンドで開いたままのアプリはWi-Fiや回線を使用します。開いている項目は保存するよう求められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "백그라운드에 열려 있는 앱은 Wi-Fi나 회선을 사용합니다. 열려 있는 항목을 저장하라는 메시지가 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apps abertos em segundo plano usam o Wi-Fi ou a linha. Você será solicitado a salvar o que estiver aberto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在后台保持打开的 App 会占用无线局域网或线路。系统会提示你存储所有打开的内容。"
          }
        }
      }
    },
