    "fix.gameMode.detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schaltet AirDrop, Handoff und Universelle Steuerung aus, die das WLAN unterbrechen, und hält den Mac wach. Fragt einmal nach deinem Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switches off AirDrop, Handoff and Universal Control, which pause the Wi-Fi, and keeps the Mac awake. Asks for your password once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desactiva AirDrop, Handoff y Control Universal, que pausan el Wi-Fi, y mantiene el Mac activo. Pide tu contraseña una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désactive AirDrop, Handoff et Contrôle universel, qui mettent le Wi-Fi en pause, et garde le Mac éveillé. Votre mot de passe n’est demandé qu’une fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirDrop, Handoff और यूनिवर्सल कंट्रोल बंद करता है, जो Wi-Fi को रोक देते हैं, और Mac को जगाए रखता है। आपका पासवर्ड एक बार माँगता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spegne AirDrop, Handoff e Controllo universale, che mettono in pausa il Wi-Fi, e tiene sveglio il Mac. Chiede la password una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wi-Fiを一時停止させるAirDrop、Handoff、ユニバーサルコントロールをオフにし、Macをスリープさせません。パスワードの入力は一度だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wi-Fi를 잠시 멈추게 하는 AirDrop, Handoff 및 유니버설 컨트롤을 끄고, Mac을 깨어 있는 상태로 유지합니다. 암호는 한 번만 묻습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desativa AirDrop, Handoff e Controle Universal, que pausam o Wi-Fi, e mantém o Mac acordado. Pede sua senha uma vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "关闭会让无线局域网暂停的隔空投送、接力和通用控制，并让 Mac 保持唤醒。只需输入一次密码。"
          }
        }
      }
    },
