    "checklist.streamIPv6.help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nutzt dein Anbieter CGNAT, umgeht IPv6 es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your provider uses carrier-grade NAT, IPv6 skips it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si tu proveedor usa NAT de operador (CGNAT), IPv6 lo evita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si votre fournisseur utilise un NAT partagé (CGNAT), IPv6 le contourne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अगर आपका प्रोवाइडर कैरियर-ग्रेड NAT का उपयोग करता है, तो IPv6 उसे बायपास कर देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se il provider usa il CGNAT, IPv6 lo evita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "プロバイダがキャリアグレードNATを使っている場合、IPv6ならそれを経由しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "인터넷 서비스 제공업체가 통신사급 NAT(CGNAT)를 사용하는 경우 IPv6는 이를 거치지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se o seu provedor usa NAT de operadora (CGNAT), o IPv6 o evita."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "如果你的运营商使用运营商级 NAT，IPv6 可以绕过它。"
          }
        }
      }
    },
