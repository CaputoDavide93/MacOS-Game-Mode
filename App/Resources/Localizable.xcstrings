          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le plan d’annulation d’une session précédente est illisible : rien n’a été modifié. Il est conservé dans Application Support/Game Ready/restore-plan.json."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पिछले सेशन का पहले जैसा करने का प्लान पढ़ा नहीं जा सकता, इसलिए कुछ नहीं बदला गया। यह Application Support/Game Ready/restore-plan.json में रखा है।"
