    "checklist.streamQuality.help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In den Einstellungen des Spieldienstes: die höchste Auflösung und Bitrate, die deine Leitung schafft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
