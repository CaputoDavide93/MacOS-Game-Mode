    "checklist.browserEnergySaver.help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In Chrome: Einstellungen → Leistung → Energiesparmodus. Er senkt die Bildrate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Chrome: Settings → Performance → Energy Saver. It lowers the frame rate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En Chrome: Configuración → Rendimiento → Ahorro de energía. Reduce la frecuencia de fotogramas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dans Chrome : Paramètres → Performances → Économiseur d’énergie. Il réduit la fréquence d’images."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chrome में: सेटिंग → परफ़ॉर्मेंस → एनर्जी सेवर। यह फ़्रेम रेट कम कर देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In Chrome: Impostazioni → Prestazioni → Risparmio energetico. Riduce i fotogrammi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromeの場合：設定 → パフォーマンス → 省エネモード。フレームレートが下がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chrome에서 설정 → 성능 → 에너지 절약 모드로 이동합니다. 이 기능은 프레임률을 낮춥니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No Chrome: Configurações → Desempenho → Economia de energia. Ela reduz a taxa de quadros."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 Chrome 中：设置 → 性能 → 节能模式。它会降低帧率。"
          }
        }
      }
    },
