    "ui.xcloud.differs": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noch nicht optimiert. Aktiviere „Spielmodus optimiert auch Better xCloud“ in den Einstellungen oder ändere es selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not tuned yet. Turn on \"Game Mode also tunes Better xCloud\" in Settings, or change it yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aún sin ajustar. Activa \"El modo Juego también ajusta Better xCloud\" en Ajustes, o cámbialo tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pas encore réglé. Activez « Le mode Jeu règle aussi Better xCloud » dans les réglages, ou modifiez-le vous-même."
          }
        },
        "hi": {
