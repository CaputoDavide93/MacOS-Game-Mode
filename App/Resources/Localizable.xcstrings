        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Better xCloudの設定を変更できませんでした。途中まで変更された設定はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Better xCloud 설정을 변경할 수 없습니다. 일부만 변경된 설정은 없습니다."
          }
        },
        "pt-BR": {
