    "ui.gameMode.help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schaltet AirDrop, Handoff und Universelle Steuerung aus, hält den Mac wach, pausiert Time Machine und beendet störende Apps. Beim Ausschalten wird jede Einstellung wiederhergestellt. Fragt einmal nach deinem Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switches off AirDrop, Handoff and Universal Control, keeps the Mac awake, pauses Time Machine and quits apps that get in the way. Turning it off puts every setting back. Asks for your password once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desactiva AirDrop, Handoff y Control Universal, mantiene el Mac activo, pausa Time Machine y cierra las apps que molestan. Al desactivarlo, todos los ajustes vuelven a su estado. Pide tu contraseña una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désactive AirDrop, Handoff et Contrôle universel, garde le Mac éveillé, suspend Time Machine et quitte les apps qui gênent. Le désactiver rétablit tous les réglages. Votre mot de passe n’est demandé qu’une fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirDrop, Handoff और यूनिवर्सल कंट्रोल बंद करता है, Mac को जगाए रखता है, Time Machine को रोकता है और रुकावट डालने वाले ऐप्स बंद करता है। इसे बंद करने पर हर सेटिंग पहले जैसी हो जाती है। आपका पासवर्ड एक बार माँगता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spegne AirDrop, Handoff e Controllo universale, tiene sveglio il Mac, mette in pausa Time Machine e chiude le app che disturbano. Disattivandola, tutte le impostazioni tornano com'erano. Chiede la password una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirDrop、Handoff、ユニバーサルコントロールをオフにし、Macをスリープさせず、Time Machineを一時停止し、妨げになるアプリを終了します。オフにするとすべての設定が元に戻ります。パスワードの入力は一度だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirDrop, Handoff 및 유니버설 컨트롤을 끄고, Mac을 깨어 있는 상태로 유지하며, Time Machine을 일시 정지하고, 방해되는 앱을 종료합니다. 끄면 모든 설정이 원래대로 돌아갑니다. 암호는 한 번만 묻습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desativa o AirDrop, o Handoff e o Controle Universal, mantém o Mac ativo, pausa o Time Machine e encerra apps que atrapalham. Ao desativá-lo, todos os ajustes voltam ao que eram. Pede sua senha uma vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "关闭隔空投送、接力和通用控制，让 Mac 保持唤醒，暂停时间机器，并退出造成干扰的 App。关闭游戏模式会恢复所有设置。只需输入一次密码。"
          }
        }
      }
    },
    "ui.gameMode.leftOn": {
