    "finding.awdlOn": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirDrop und Handoff sind an. Sie unterbrechen das WLAN ab und zu. Der Spielmodus schaltet sie aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop and Handoff are on. They pause the Wi-Fi now and then. Game Mode switches them off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirDrop y Handoff están activados. De vez en cuando pausan el Wi-Fi. El modo Juego los desactiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirDrop et Handoff sont activés. Ils mettent parfois le Wi-Fi en pause. Le mode Jeu les désactive."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirDrop और Handoff चालू हैं। ये बीच-बीच में Wi-Fi को रोक देते हैं। गेम मोड इन्हें बंद कर देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirDrop e Handoff sono attivi e fermano il Wi-Fi ogni tanto. La Modalità gioco li spegne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirDropとHandoffがオンです。ときどきWi-Fiを一時停止させます。ゲームモードがオフにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirDrop과 Handoff가 켜져 있습니다. 이 기능들은 때때로 Wi-Fi를 잠시 멈춥니다. 게임 모드가 이 기능들을 끕니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O AirDrop e o Handoff estão ativados. Eles pausam o Wi-Fi de vez em quando. O Modo Jogo os desativa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "隔空投送和接力已打开。它们会不时暂停无线局域网。游戏模式会将其关闭。"
          }
        }
      }
    },
