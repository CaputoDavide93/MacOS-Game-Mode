        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wi-Fi 2.4 GHz पर है, जो भीड़ भरा और धीमा है। 5 या 6 GHz नेटवर्क से जुड़ें, या केबल लगाएँ।"
          }
        },
        "it": {
          "stringUnit": {
