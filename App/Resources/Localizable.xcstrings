    "ui.xcloud.notAllowed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS hat Game Ready nicht erlaubt, den Browser zu steuern. Aktiviere es unter Systemeinstellungen → Datenschutz & Sicherheit → Automation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS didn't allow Game Ready to control the browser. Turn it on in System Settings → Privacy & Security → Automation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS no ha permitido que Game Ready controle el navegador. Actívalo en Ajustes del Sistema → Privacidad y seguridad → Automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS n’a pas autorisé Game Ready à contrôler le navigateur. Activez-le dans Réglages Système → Confidentialité et sécurité → Automatisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS ने Game Ready को ब्राउज़र नियंत्रित करने की अनुमति नहीं दी। इसे सिस्टम सेटिंग्ज़ → गोपनीयता और सुरक्षा → ऑटोमेशन में चालू करें।"
