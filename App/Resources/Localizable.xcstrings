    },
    "ui.settings.why": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cloud-Gaming ruckelt aus vielen Gründen: das WLAN des Mac, die Leitung im Haushalt oder die Server des Spiels. Game Ready zeigt dir, woran es liegt, vor dem Start und während du spielst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud gaming lags for many reasons: the Mac's own Wi-Fi, the household line, or the game's servers. Game Ready tells you which one, before you start and while you play."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El juego en la nube va con retardo por muchas razones: el Wi-Fi del propio Mac, la línea de casa o los servidores del juego. Game Ready te dice cuál es, antes de empezar y mientras juegas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le jeu dans le cloud peut ramer pour bien des raisons : le Wi-Fi du Mac, la ligne du foyer ou les serveurs du jeu. Game Ready vous dit laquelle, avant de commencer et pendant que vous jouez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "क्लाउड गेमिंग में लैग कई कारणों से होता है: Mac का अपना Wi-Fi, घर की लाइन, या गेम के सर्वर। Game Ready आपको बताता है कि कौन-सा, खेलने से पहले और खेलते समय भी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il cloud gaming rallenta per tanti motivi: il Wi-Fi del Mac, la linea di casa o i server del gioco. Game Ready ti dice quale, prima di iniziare e mentre giochi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "クラウドゲームのラグにはさまざまな原因があります。Mac自体のWi-Fi、家庭の回線、ゲームのサーバなどです。Game Readyは、プレイ前にもプレイ中にも、どれが原因かを示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "클라우드 게임의 랙은 Mac 자체의 Wi-Fi, 가정의 회선, 게임 서버 등 여러 원인으로 발생합니다. Game Ready는 플레이를 시작하기 전과 플레이하는 동안 원인이 무엇인지 알려 줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jogos na nuvem travam por vários motivos: o próprio Wi-Fi do Mac, a linha da casa ou os servidores do jogo. O Game Ready mostra qual deles, antes de começar e enquanto você joga."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "云游戏卡顿的原因有很多：Mac 自身的无线局域网、家庭线路或游戏服务器。Game Ready 会在你开始前和游戏过程中告诉你是哪一个。"
          }
        }
      }
    },
