    "checklist.airDrop.help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirDrop teilt sich den Funk mit dem WLAN und unterbricht es, um nach Geräten in der Nähe zu suchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop shares the Wi-Fi radio and pauses it to look for nearby devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirDrop comparte la radio Wi-Fi y la pausa para buscar dispositivos cercanos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirDrop partage la radio Wi-Fi et la met en pause pour chercher des appareils à proximité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirDrop उसी Wi-Fi रेडियो का उपयोग करता है और आस-पास के डिवाइस खोजने के लिए उसे रोक देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirDrop condivide la radio Wi-Fi e la ferma per cercare dispositivi vicini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirDropはWi-Fiと同じ無線を使い、近くのデバイスを探すあいだWi-Fiを一時停止させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirDrop은 Wi-Fi 무선 장치를 함께 사용하며, 주변 기기를 찾는 동안 Wi-Fi를 잠시 멈춥니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O AirDrop compartilha o rádio Wi-Fi e o pausa para procurar dispositivos próximos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "隔空投送与无线局域网共用无线电，并会暂停无线局域网来查找附近的设备。"
          }
        }
      }
    },
    "checklist.airDrop.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
