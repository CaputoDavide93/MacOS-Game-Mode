    "checklist.locationServices.help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Ortung lässt das WLAN nach Netzwerken suchen und unterbricht es dabei. Oder schalte nur Systemdienste → Netzwerk & Drahtlos aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location makes the Wi-Fi scan for networks, which pauses it. Or switch off just System Services → Networking & Wireless."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La localización hace que el Wi-Fi busque redes, y eso lo pausa. O desactiva solo Servicios del sistema → Redes y conexión inalámbrica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La localisation fait chercher des réseaux au Wi-Fi, ce qui le met en pause. Ou désactivez seulement Services système → Réseau et sans fil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्थान के कारण Wi-Fi नेटवर्क खोजता है, जिससे वह रुक जाता है। या केवल सिस्टम सेवाएँ → नेटवर्किंग और वायरलेस बंद करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La localizzazione fa cercare reti al Wi-Fi, che si ferma. In alternativa disattiva solo Servizi di sistema → Rete e wireless."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "位置情報を使うとWi-Fiがネットワークを探し、そのあいだ一時停止します。システムサービス → ネットワークとワイヤレスだけをオフにすることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "위치 서비스는 Wi-Fi가 네트워크를 검색하게 하여 Wi-Fi를 잠시 멈춥니다. 또는 시스템 서비스 → 네트워킹 및 무선만 끌 수도 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A localização faz o Wi-Fi procurar redes, o que o pausa. Ou desative apenas Serviços do Sistema → Rede e Conexão Sem Fio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "定位会让无线局域网扫描网络，从而使其暂停。也可以只关闭系统服务 → 网络与无线局域网。"
          }
        }
      }
    },
