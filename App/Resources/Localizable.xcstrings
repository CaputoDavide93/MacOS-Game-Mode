    "ui.changes.unreadablePlan": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Plan zum Zurücksetzen aus einer früheren Sitzung ist nicht lesbar, daher wurde nichts geändert. Er liegt unter Application Support/Game Ready/restore-plan.json."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The undo plan from an earlier session can't be read, so nothing was changed. It's kept in Application Support/Game Ready/restore-plan.json."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
