    "checklist.airDrop.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop shares the Wi-Fi radio and pauses it to look for nearby devices."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirDrop condivide la radio Wi-Fi e la ferma per cercare dispositivi vicini."
          }
        }
      }
    },
    "checklist.airDrop.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop set to No One"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirDrop impostato su Nessuno"
          }
        }
      }
    },
    "checklist.browserEnergySaver.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Chrome: Settings → Performance → Energy Saver. It lowers the frame rate."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In Chrome: Impostazioni → Prestazioni → Risparmio energetico. Riduce i fotogrammi."
          }
        }
      }
    },
    "checklist.browserEnergySaver.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser energy saver off"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Risparmio energetico del browser disattivato"
          }
        }
      }
    },
    "checklist.controllerUSB.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Less input delay than Bluetooth, and Bluetooth shares the Wi-Fi radio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Meno ritardo del Bluetooth, che condivide la radio Wi-Fi."
          }
        }
      }
    },
    "checklist.controllerUSB.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controller on a USB cable"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Controller collegato via USB"
          }
        }
      }
    },
    "checklist.handoff.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handoff uses the same radio as AirDrop."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Handoff usa la stessa radio di AirDrop."
          }
        }
      }
    },
    "checklist.handoff.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handoff off"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Handoff disattivato"
          }
        }
      }
    },
    "checklist.locationServices.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location makes the Wi-Fi scan for networks, which pauses it. Or switch off just System Services → Networking & Wireless."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La localizzazione fa cercare reti al Wi-Fi, che si ferma. In alternativa disattiva solo Servizi di sistema → Rete e wireless."
          }
        }
      }
    },
    "checklist.locationServices.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location Services off while gaming"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Localizzazione disattivata mentre giochi"
          }
        }
      }
    },
    "checklist.streamIPv6.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your provider uses carrier-grade NAT, IPv6 skips it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se il provider usa il CGNAT, IPv6 lo evita."
          }
        }
      }
    },
    "checklist.streamIPv6.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
