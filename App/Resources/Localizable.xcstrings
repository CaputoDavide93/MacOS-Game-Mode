    "fix.betterXcloud.detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Höchste Bitrate, H.264-Profil „High“, IPv6 bevorzugen. Deine eigenen Einstellungen kommen danach zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highest bitrate, high H.264 profile, Prefer IPv6. Your own settings come back afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tasa de bits máxima, perfil alto de H.264, Preferir IPv6. Después vuelven tus propios ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Débit maximal, profil H.264 élevé, Préférer IPv6. Vos propres réglages reviennent ensuite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सबसे ऊँचा बिटरेट, हाई H.264 प्रोफ़ाइल, IPv6 को प्राथमिकता। बाद में आपकी अपनी सेटिंग्ज़ वापस आ जाती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bitrate massimo, profilo H.264 alto, Preferisci IPv6. Dopo tornano le tue impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "最高ビットレート、H.264 Highプロファイル、IPv6優先。終了後は元の設定に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "최고 비트레이트, H.264 높은 프로파일, IPv6 우선 사용. 이후 원래 설정으로 돌아갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bitrate máxima, perfil H.264 High, preferir IPv6. Seus próprios ajustes voltam depois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "最高码率、H.264 High 配置、优先使用 IPv6。之后会恢复你自己的设置。"
          }
        }
      }
    },
