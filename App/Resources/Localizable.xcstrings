    "checklist.controllerUSB.help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Weniger Eingabeverzögerung als Bluetooth, und Bluetooth teilt sich den Funk mit dem WLAN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Less input delay than Bluetooth, and Bluetooth shares the Wi-Fi radio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menos retardo que con Bluetooth, y Bluetooth comparte la radio Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moins de latence qu’en Bluetooth, qui partage en plus la radio Wi-Fi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth की तुलना में इनपुट में कम देरी होती है, और Bluetooth भी Wi-Fi रेडियो का उपयोग करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Meno ritardo del Bluetooth, che condivide la radio Wi-Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetoothより入力遅延が少なく、BluetoothはWi-Fiと同じ無線を使うためです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth보다 입력 지연이 적고, Bluetooth는 Wi-Fi 무선 장치를 함께 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menos atraso de comando que o Bluetooth, e o Bluetooth compartilha o rádio Wi-Fi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "输入延迟比蓝牙更低，而且蓝牙与无线局域网共用无线电。"
          }
        }
